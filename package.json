{
  "name": "convergo",
  "version": "0.6.0",
  "description": "Intent-driven planning, implementation and independent review with bounded repairs",
  "type": "module",
  "private": true,
  "main": ".opencode/plugins/convergo.js",
  "pi": {
    "extensions": [
      "./.pi/extensions/convergo.ts"
    ],
    "skills": [
      "./plugins/generic/skills"
    ]
  },
  "homepage": "https://github.com/gomilesf/convergo",
  "repository": "https://github.com/gomilesf/convergo",
  "license": "MIT",
  "keywords": [
    "ai",
    "agent-skills",
    "codex",
    "claude-code",
    "compound-engineering",
    "fresh-reviewer",
    "workflow-automation"
  ],
  "scripts": {
    "sync": "bun run scripts/sync-platform-skills.ts",
    "validate": "bun run scripts/validate.ts",
    "eval:trigger": "bun run scripts/run-trigger-evals.ts",
    "plugin:validate": "claude plugin validate .claude-plugin/marketplace.json && claude plugin validate plugins/claude",
    "test": "bun test",
    "eval:wrapper": "bun run evals/wrapper-behavior/wrapper-compliance.ts",
    "eval:repin": "bun run evals/wrapper-behavior/resume-repin.ts",
    "eval:scoping": "bun run evals/wrapper-behavior/orchestrator-scoping.ts",
    "eval:convergence": "bun run evals/convergence/run.ts"
  },
  "devDependencies": {
    "bun-types": "^1.0.0"
  }
}
